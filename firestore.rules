rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- GLOBAL HELPERS ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'machariag605@gmail.com' ||
        request.auth.token.email == 'danuthiaandassociates@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }
    
    function isStaff() {
      return isSignedIn() && (
        isAdmin() ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['project_manager', 'architect', 'engineer', 'surveyor', 'planner', 'staff']
      );
    }
    
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    
    function incoming() {
      return request.resource.data;
    }
    
    function existing() {
      return resource.data;
    }

    // --- DEFAULT DENY ---
    match /{document=**} {
      allow read, write: if false;
    }

    // --- COLLECTIONS ---

    match /siteResources/{resourceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /projects/{projectId} {
      allow read: if true;
      allow write: if isAdmin();
      
      match /tasks/{taskId} {
        allow read: if isStaff() || isAdmin() || (isSignedIn() && get(/databases/$(database)/documents/projects/$(projectId)).data.clientId == request.auth.uid);
        allow write: if isStaff() || isAdmin();
      }
    }

    match /newsletter/{entryId} {
      allow create: if incoming().keys().hasAll(['email', 'createdAt']) && incoming().email is string;
      allow read, delete: if isAdmin();
    }

    match /bookingRequests/{requestId} {
      allow create: if true; // Any visitor can book
      allow read, update, delete: if isAdmin();
    }
    
    match /leads/{leadId} {
      allow create: if true;
      allow read, write: if isAdmin();
    }
    
    match /clientLeads/{leadId} {
      allow create: if true;
      allow read, write: if isAdmin();
    }

    match /testimonials/{testimonialId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin() || isStaff();
      allow create: if isOwner(userId);
      allow update: if (isOwner(userId) && !incoming().diff(existing()).affectedKeys().hasAny(['role', 'isAdmin'])) || isAdmin();
      allow delete: if isAdmin();
    }

    match /milestones/{milestoneId} {
      allow read: if isAdmin() || isStaff() || (isSignedIn() && existing().clientId == request.auth.uid);
      allow write: if isAdmin() || isStaff();
    }

    match /projectUpdates/{updateId} {
      allow read: if isAdmin() || isStaff() || (isSignedIn() && existing().clientId == request.auth.uid);
      allow write: if isAdmin() || isStaff();
    }

    match /documents/{docId} {
      allow read: if isAdmin() || isStaff() || (isSignedIn() && existing().clientId == request.auth.uid);
      allow create: if isAdmin() || isStaff() || (isSignedIn() && incoming().clientId == request.auth.uid);
      allow update: if isAdmin() || isStaff();
      allow delete: if isAdmin();
      
      match /chunks/{chunkId} {
        allow read: if isAdmin() || isStaff() || (isSignedIn() && get(/databases/$(database)/documents/documents/$(docId)).data.clientId == request.auth.uid);
        allow write: if isAdmin() || isStaff() || (isSignedIn() && get(/databases/$(database)/documents/documents/$(docId)).data.clientId == request.auth.uid);
      }
    }

    match /technicalReports/{reportId} {
      allow read: if isAdmin() || isStaff() || (isSignedIn() && existing().clientId == request.auth.uid);
      allow write: if isAdmin() || isStaff();
    }

    match /invoices/{invoiceId} {
      allow read: if isAdmin() || isStaff() || (isSignedIn() && existing().clientId == request.auth.uid);
      allow write: if isAdmin() || isStaff();
    }

    match /messages/{messageId} {
      allow read: if isAdmin() || isStaff() || (isSignedIn() && (existing().senderId == request.auth.uid || existing().receiverId == request.auth.uid));
      allow create: if isSignedIn() && incoming().senderId == request.auth.uid;
      allow update: if isAdmin() || (isSignedIn() && existing().receiverId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['read']));
      allow delete: if isAdmin();
    }

    match /internalMessages/{messageId} {
      allow read, write: if isStaff() || isAdmin();
    }

    match /internalLogs/{logId} {
      allow read: if isStaff() || isAdmin();
      allow create: if isStaff() || isAdmin() || isSignedIn(); // Client can log their own actions (activity feed)
      allow update, delete: if isAdmin();
    }

    match /notifications/{notifId} {
      allow read: if isAdmin() || isOwner(existing().userId);
      allow write: if isAdmin() || isStaff();
    }

    match /budgetLedgers/{ledgerId} {
      allow read, write: if isAdmin() || isStaff();
    }

    match /annotations/{annotationId} {
      allow read, write: if isAdmin() || isStaff();
    }

    match /projectModels/{modelId} {
      allow read: if isAdmin() || isStaff() || (isSignedIn() && existing().clientId == request.auth.uid);
      allow write: if isAdmin() || isStaff();
    }

    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

  }
}
