{
  "entities": {
    "BookingRequest": {
      "title": "Booking Request",
      "description": "A consultation booking request submitted by a client.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "The UID of the user who submitted the request."
        },
        "fullName": {
          "type": "string",
          "description": "The full name of the client."
        },
        "projectScale": {
          "type": "string",
          "enum": ["residential", "commercial", "regional"],
          "description": "The scale of the project."
        },
        "preferredDate": {
          "type": "string",
          "description": "The preferred date for the consultation (YYYY-MM-DD)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "The timestamp when the request was created."
        },
        "status": {
          "type": "string",
          "enum": ["pending", "reviewed", "contacted"],
          "description": "The status of the booking request."
        }
      },
      "required": ["userId", "fullName", "projectScale", "preferredDate", "createdAt", "status"]
    },
    "User": {
      "title": "User Profile",
      "description": "User profile data.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string"
        },
        "role": {
          "type": "string",
          "enum": ["client", "admin"]
        }
      },
      "required": ["email", "role"]
    },
    "ProjectUpdate": {
      "title": "Project Update",
      "description": "An update on a client's project progress.",
      "type": "object",
      "properties": {
        "clientId": {
          "type": "string",
          "description": "The UID of the client this update belongs to."
        },
        "title": {
          "type": "string",
          "description": "The title of the update."
        },
        "description": {
          "type": "string",
          "description": "Detailed description of the update."
        },
        "imageUrl": {
          "type": "string",
          "description": "Optional URL to an image showing progress."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the update was posted."
        }
      },
      "required": ["clientId", "title", "description", "createdAt"]
    },
    "Message": {
      "title": "Message",
      "description": "A secure message between a client and an admin.",
      "type": "object",
      "properties": {
        "senderId": {
          "type": "string",
          "description": "The UID of the sender."
        },
        "receiverId": {
          "type": "string",
          "description": "The UID of the receiver (admin or client)."
        },
        "text": {
          "type": "string",
          "description": "The content of the message."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the message was sent."
        },
        "read": {
          "type": "boolean",
          "description": "Whether the message has been read by the receiver."
        }
      },
      "required": ["senderId", "receiverId", "text", "createdAt", "read"]
    },
    "Document": {
      "title": "Document",
      "description": "A secure document uploaded by a client or admin.",
      "type": "object",
      "properties": {
        "clientId": {
          "type": "string",
          "description": "The UID of the client this document belongs to."
        },
        "fileName": {
          "type": "string",
          "description": "The name of the file."
        },
        "fileType": {
          "type": "string",
          "description": "The MIME type of the file."
        },
        "fileData": {
          "type": "string",
          "description": "The base64 encoded content of the file."
        },
        "uploadedBy": {
          "type": "string",
          "description": "The UID of the user who uploaded the document."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the document was uploaded."
        }
      },
      "required": ["clientId", "fileName", "fileType", "fileData", "uploadedBy", "createdAt"]
    },
    "ClientLead": {
      "title": "Client Lead",
      "description": "A lead extracted by the AI Concierge.",
      "type": "object",
      "properties": {
        "client": {
          "type": "object",
          "properties": {
            "full_name": { "type": "string" },
            "contact_preference": { "type": "string" }
          }
        },
        "project": {
          "type": "object",
          "properties": {
            "scope": { "type": "string" },
            "location": { "type": "string" },
            "budget_tier": { "type": "string" },
            "urgency_flag": { "type": "boolean" }
          }
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "type": "string",
          "enum": ["new", "contacted", "archived"]
        }
      },
      "required": ["client", "project", "createdAt", "status"]
    },
    "Milestone": {
      "title": "Project Milestone",
      "description": "A milestone in a client's project timeline.",
      "type": "object",
      "properties": {
        "clientId": {
          "type": "string",
          "description": "The UID of the client this milestone belongs to."
        },
        "title": {
          "type": "string",
          "description": "The title of the milestone."
        },
        "status": {
          "type": "string",
          "enum": ["completed", "in-progress", "upcoming"],
          "description": "The current status of the milestone."
        },
        "date": {
          "type": "string",
          "description": "The scheduled or completion date (YYYY-MM-DD)."
        },
        "order": {
          "type": "number",
          "description": "The order of the milestone in the timeline."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["clientId", "title", "status", "order", "createdAt"]
    },
    "Invoice": {
      "title": "Invoice",
      "description": "A project invoice for a client.",
      "type": "object",
      "properties": {
        "clientId": { "type": "string" },
        "amount": { "type": "number" },
        "description": { "type": "string" },
        "status": { "type": "string", "enum": ["unpaid", "paid"] },
        "dueDate": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["clientId", "amount", "description", "status", "dueDate", "createdAt"]
    },
    "ProjectModel": {
      "title": "3D Project Model",
      "description": "A 3D model of a project for interactive viewing.",
      "type": "object",
      "properties": {
        "clientId": { "type": "string" },
        "title": { "type": "string" },
        "modelUrl": { "type": "string", "description": "URL to the 3D model file (e.g. .glb)." },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["clientId", "title", "modelUrl", "createdAt"]
    },
    "Notification": {
      "title": "Notification",
      "description": "An in-app notification for a user.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "message", "read", "createdAt"]
    },
    "Annotation": {
      "title": "Blueprint Annotation",
      "description": "An annotation on a blueprint.",
      "type": "object",
      "properties": {
        "blueprintId": { "type": "string" },
        "authorId": { "type": "string" },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "comment": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["blueprintId", "authorId", "x", "y", "comment", "createdAt"]
    },
    "Testimonial": {
      "title": "Client Testimonial",
      "description": "A review submitted by a client.",
      "type": "object",
      "properties": {
        "clientId": { "type": "string" },
        "clientName": { "type": "string" },
        "rating": { "type": "number" },
        "comment": { "type": "string" },
        "approved": { "type": "boolean" },
        "projectType": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["clientId", "clientName", "rating", "comment", "approved", "projectType", "createdAt"]
    }
  },
  "firestore": {
    "/clientLeads/{leadId}": {
      "schema": {
        "$ref": "#/entities/ClientLead"
      },
      "description": "Stores client leads extracted by the AI Concierge."
    },
    "/milestones/{milestoneId}": {
      "schema": {
        "$ref": "#/entities/Milestone"
      },
      "description": "Stores project milestones for clients."
    },
    "/bookingRequests/{requestId}": {
      "schema": {
        "$ref": "#/entities/BookingRequest"
      },
      "description": "Stores all consultation booking requests."
    },
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/User"
      },
      "description": "Stores user profiles and roles."
    },
    "/projectUpdates/{updateId}": {
      "schema": {
        "$ref": "#/entities/ProjectUpdate"
      },
      "description": "Stores project updates for clients."
    },
    "/messages/{messageId}": {
      "schema": {
        "$ref": "#/entities/Message"
      },
      "description": "Stores secure messages between clients and admins."
    },
    "/documents/{documentId}": {
      "schema": {
        "$ref": "#/entities/Document"
      },
      "description": "Stores secure documents for clients."
    },
    "/annotations/{annotationId}": {
      "schema": {
        "$ref": "#/entities/Annotation"
      },
      "description": "Stores annotations on blueprints."
    },
    "/invoices/{invoiceId}": {
      "schema": {
        "$ref": "#/entities/Invoice"
      },
      "description": "Stores project invoices for clients."
    },
    "/projectModels/{modelId}": {
      "schema": {
        "$ref": "#/entities/ProjectModel"
      },
      "description": "Stores 3D project models for interactive viewing."
    },
    "/notifications/{notificationId}": {
      "schema": {
        "$ref": "#/entities/Notification"
      },
      "description": "Stores in-app notifications for users."
    },
    "/testimonials/{testimonialId}": {
      "schema": {
        "$ref": "#/entities/Testimonial"
      },
      "description": "Stores client testimonials."
    }
  }
}
